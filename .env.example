# Copy to .env and fill in. .env is gitignored — DO NOT COMMIT.

ENV=dev
RANDOM_SEED=42
LOG_LEVEL=INFO

# Inference backend selection: groq | llama_cpp | mock
MISINFO_BACKEND=groq
# File-based response cache (sha256-keyed). Set to false to disable.
MISINFO_CACHE=true
# Per NFR-Priv-1: log raw claim text in access logs. Default false (redacted).
MISINFO_LOG_CLAIMS=false

# Groq (primary backend)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=qwen/qwen-2.5-32b

# Langfuse self-hosted observability — leave LANGFUSE_HOST blank to disable tracing
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Azure OpenAI — credentials stored for later use. No backend implementation yet.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# Optional credentials (used by other phases)
OPENAI_API_KEY=
HF_TOKEN=
