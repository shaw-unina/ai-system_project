# Copy to .env and fill in. .env is gitignored — DO NOT COMMIT.

ENV=dev
RANDOM_SEED=42
LOG_LEVEL=INFO

# Inference backend selection: groq | llama_cpp | mock
MISINFO_BACKEND=groq
# File-based response cache (sha256-keyed). Set to false to disable.
MISINFO_CACHE=true
# Optional path to a JSONL evidence corpus loaded at service startup.
# Each line: {"source_id": "...", "text": "...", "url": "..."}
# Empty = run with no corpus (every claim will return NotEnoughEvidence).
MISINFO_CORPUS_PATH=
# Profile shortcut: smoke | averitec | wiki | union
# Resolves to data/processed/<profile>_corpus.jsonl. Only used when
# MISINFO_RETRIEVER=bm25. Build profiles with scripts/build_corpus.py.
MISINFO_CORPUS_PROFILE=smoke

# Phase 11.1 — retriever selection
# web  = live Tavily search (default; needs SEARCH_API_KEY)
# bm25 = BM25 over the corpus above
MISINFO_RETRIEVER=web
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_DAILY_BUDGET=1000

# Phase 11.1 — Google Fact Check Tools sidecar (display-only)
# Empty = sidecar shows "disabled" state; the verify pipeline is unaffected.
GOOGLE_FACT_CHECK_API_KEY=
GOOGLE_FACT_CHECK_DAILY_BUDGET=1000
# Per NFR-Priv-1: log raw claim text in access logs. Default false (redacted).
MISINFO_LOG_CLAIMS=false

# Groq (primary backend)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=qwen/qwen-2.5-32b

# Langfuse self-hosted observability — leave LANGFUSE_HOST blank to disable tracing
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Azure OpenAI — credentials stored for later use. No backend implementation yet.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# Optional credentials (used by other phases)
OPENAI_API_KEY=
HF_TOKEN=

# Phase 11 — service hardening. Leave empty to disable auth (local dev only).
# Comma-separated bearer tokens accepted on /v1/verify and /v1/batch.
MISINFO_API_KEYS=
# Optional bearer token for /metrics scraping. Empty = open.
MISINFO_METRICS_TOKEN=
# Per-key sliding-window cap, requests per minute.
MISINFO_RATE_LIMIT_PER_MIN=60

# Frontend (Phase 10/11) — read by the Next.js server, never the browser.
BACKEND_URL=http://app:8000
BACKEND_API_KEY=
BACKEND_METRICS_TOKEN=
# Empty = /operator gate disabled. Set to enable the dashboard password gate.
OPERATOR_PASSWORD=
